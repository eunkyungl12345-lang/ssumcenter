{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/airtable?summary=1", "schedule": "0 0 * * *" }
  ],
  "headers": [
    {
      "source": "/(admin|1on1|1on1-admin|rotation-admin|lineup|attendance|vote-admin|vote-test|participants|response|matching|login|auth-callback|my|members|dev|guide|guide-1on1|patch-notes|links|marriage|seatmap|vote-guide|vote-ops|reconnect|setup-reconnect)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(admin|1on1|1on1-admin|rotation-admin|lineup|attendance|vote-admin|vote-test|participants|response|matching|login|auth-callback|my|members|dev|guide|guide-1on1|patch-notes|links|marriage|seatmap|vote-guide|vote-ops|reconnect|setup-reconnect).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    },
    {
      "_comment": "회차 목록·신청서는 캐시하지 않는다. 새 회차를 열었는데 옛날 목록이 보이면 안 되므로.",
      "source": "/(rounds.js|rotation-form|rotation-form.html|rotation-apply|rotation-apply.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
